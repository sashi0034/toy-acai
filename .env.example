# Copy this to .env and fill in the real values on the login node.
# Required Slack bot OAuth scopes: files:write, files:read, chat:write
# Invite the bot user to SLACK_CHANNEL_ID before uploading files.
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL_ID=C0123456789

# Slack upload backend. Options: "off" | "direct" | "external".
# "external" writes records to outputs/<timestamp>/slack/pending without networking.
SLACK_POST_BACKEND=direct

# Number of CPU processes used for non-rendering rollout collection.
ROLLOUT_WORKER_COUNT=4
